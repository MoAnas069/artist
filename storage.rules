rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // ─── Content images managed by admin ─────────────
    match /artworks/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 25 * 1024 * 1024;
    }

    match /journal/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 25 * 1024 * 1024;
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 25 * 1024 * 1024;
    }

    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 15 * 1024 * 1024;
    }

    // ─── Reference files from contact form ───────────
    match /references/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // ─── Catch-all: deny ─────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
