rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Artworks ─────────────────────────────────────
    match /artworks/{artworkId} {
      allow read, write: if true;
    }

    // ─── Journal ──────────────────────────────────────
    match /journal/{postId} {
      allow read, write: if true;
    }

    // ─── Products ─────────────────────────────────────
    match /products/{productId} {
      allow read, write: if true;
    }

    // ─── Messages ─────────────────────────────────────
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // ─── Settings ─────────────────────────────────────
    match /settings/{document} {
      allow read, write: if true;
    }

    // ─── Catch-all ────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
