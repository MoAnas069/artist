rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // ─── Artworks ─────────────────────────────────────
    match /artworks/{artworkId} {
      // Public can read published artworks
      allow read: if resource.data.published == true;
      // Admin can read all, write all
      allow read, write: if isAuthenticated();
    }

    // ─── Journal ──────────────────────────────────────
    match /journal/{postId} {
      // Public can read published posts
      allow read: if resource.data.published == true;
      // Admin can read all, write all
      allow read, write: if isAuthenticated();
    }

    // ─── Products ─────────────────────────────────────
    match /products/{productId} {
      // Public can read available products
      allow read: if resource.data.available == true;
      // Admin can read all, write all
      allow read, write: if isAuthenticated();
    }

    // ─── Messages ─────────────────────────────────────
    match /messages/{messageId} {
      // Public can create messages (contact form)
      allow create: if true;
      // Only admin can read, update, delete
      allow read, update, delete: if isAuthenticated();
    }

    // ─── Settings ─────────────────────────────────────
    match /settings/{document} {
      // Public can read settings
      allow read: if true;
      // Only admin can write
      allow write: if isAuthenticated();
    }

    // ─── Catch-all: deny ──────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
